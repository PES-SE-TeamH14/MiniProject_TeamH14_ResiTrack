# Copy this file to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=5000
# Local MongoDB, or your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/resitrack
# Where the React app runs in development (used for CORS)
CLIENT_ORIGIN=http://localhost:5173
# Secret used to sign login tokens (FR-02). Use a long random string and keep it private.
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts (NFR-05: 30 minutes)
JWT_EXPIRES_IN=30m
# Number of API worker processes, one per CPU core you want to use (NFR-01). 1 = no cluster.
WEB_CONCURRENCY=1
# bcrypt cost factor for passwords (NFR-03: at least 12)
BCRYPT_ROUNDS=12
# Used once by `npm run create-admin` to create the first Administrator account
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@resitrack.local
ADMIN_PASSWORD=change-me-please

# Rent reminders (FR-07): daily job that reminds tenants of upcoming and overdue rent
# Day of the month rent is due (1-28)
RENT_DUE_DAY=5
# Start reminding this many days before the due date (at least 3)
REMINDER_DAYS_BEFORE=3
# When the daily job runs (cron format) and in which time zone
REMINDER_CRON=0 9 * * *
REMINDER_TIMEZONE=Asia/Kolkata
# Set to false to switch the daily job off
REMINDERS_ENABLED=true
